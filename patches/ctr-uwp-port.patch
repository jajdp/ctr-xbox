 	const char *sdlBasePath;
 };
 
+#if defined(CTR_NATIVE_UWP)
+/*
+ * El Device Portal de la Xbox escribe un temporal en D:\, el volumen del modo desarrollador,
+ * que va justo de espacio: una subida de 578 MB responde 500 aunque LocalState tenga sitio de
+ * sobra. El disco se sube entonces en trozos (xbox\herramientas\partir_disco.py) y se une
+ * aquí, la primera vez que el juego arranca.
+ */
+static void CtrUwp_JoinDiscParts(void)
+{
+	const char *assetsDir = NativeStorage_GetImportAssetDir();
+	char destino[NATIVE_STORAGE_PATH_MAX];
+	char indice[NATIVE_STORAGE_PATH_MAX];
+	char parte[NATIVE_STORAGE_PATH_MAX];
+	char linea[128];
+	FILE *f;
+	FILE *salida;
+	int partes = 0;
+	int i;
+
+	if ((assetsDir == NULL) || (assetsDir[0] == '\0'))
+	{
+		return;
+	}
+	SDL_snprintf(destino, sizeof(destino), "%s/ctr-u.bin", assetsDir);
+	SDL_snprintf(indice, sizeof(indice), "%s/ctr-u.bin.partes", assetsDir);
+
+	f = fopen(destino, "rb");
+	if (f != NULL)
+	{
+		fclose(f);
+		return; /* el disco ya está entero */
+	}
+
+	f = fopen(indice, "r");
+	if (f == NULL)
+	{
+		return;
+	}
+	while (fgets(linea, (int)sizeof(linea), f) != NULL)
+	{
+		if (SDL_strncmp(linea, "partes=", 7) == 0)
+		{
+			partes = SDL_atoi(linea + 7);
+		}
+	}
+	fclose(f);
+	if ((partes <= 0) || (partes > 99))
+	{
+		return;
+	}
+
+	printf("[CTR Native] Uniendo %d trozos del disco...\n", partes);
+	salida = fopen(destino, "wb");
+	if (salida == NULL)
+	{
+		fprintf(stderr, "[CTR Native] No se pudo crear %s\n", destino);
+		return;
+	}
+	for (i = 1; i <= partes; i++)
+	{
+		static char bloque[1 << 20];
+		size_t leidos;
+
+		SDL_snprintf(parte, sizeof(parte), "%s/ctr-u.bin.%03d", assetsDir, i);
+		f = fopen(parte, "rb");
+		if (f == NULL)
+		{
+			fprintf(stderr, "[CTR Native] Falta el trozo %s\n", parte);
+			fclose(salida);
+			remove(destino);
+			return;
+		}
+		while ((leidos = fread(bloque, 1, sizeof(bloque), f)) > 0)
+		{
+			fwrite(bloque, 1, leidos, salida);
+		}
+		fclose(f);
+	}
+	fclose(salida);
+
+	for (i = 1; i <= partes; i++)
+	{
+		SDL_snprintf(parte, sizeof(parte), "%s/ctr-u.bin.%03d", assetsDir, i);
+		remove(parte);
+	}
+	remove(indice);
+	printf("[CTR Native] Disco unido en %s\n", destino);
+}
+#endif
