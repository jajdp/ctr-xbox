+// Decide si esta instancia puede animarse al doble de fotogramas. Portado de
+// High Octane, traducido a los accesores de CTRPad: aqui `model->headers` es una
+// referencia de invitado y hay que pedirla, no leerla como puntero.
+b32 INSTANCE_Use60FpsAnimation(struct Instance *inst)
+{
+	struct ModelHeader *headers;
+	struct GameTracker *gGT;
+
+	if (!CTR_NATIVE_60FPS_ACTIVE || (inst == NULL) || (inst->model == NULL) || (inst->model->numHeaders <= 0))
+	{
+		return false;
+	}
+
+	headers = Model_GetHeaders(inst->model, "animacion a 60 FPS");
+	if (headers == NULL)
+	{
+		return false;
+	}
+
+	// «big1» es el modelo de los personajes grandes del podio
+	if (memcmp(headers[0].name, "big1", 4) == 0)
+	{
+		return false;
+	}
+
+	if (inst->model->id == DYNAMIC_FIREBALL)
+	{
+		return false;
+	}
+
+	gGT = sdata->gGT;
+	if ((gGT != NULL) && (gGT->overlayIndex_Threads == OVERLAY_INDEX_PODIUMS))
+	{
+		// en el podio solo el corredor del jugador
+		struct Driver *driver = gGT->drivers[0];
+		return (driver != NULL) && (driver->instSelf == inst);
+	}
+
