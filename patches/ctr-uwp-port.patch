+// 60 FPS (portado de High Octane). El juego de PlayStation corre su lógica a
+// 30 Hz; para doblar la imagen sin acelerar la partida hacen falta dos cosas:
+//   - ajustar las constantes de duración y de velocidad (FPS_DOUBLE y compañía);
+//   - dejar a 30 Hz lo que no se puede dar dos veces por cuadro, ejecutándolo
+//     solo en los cuadros impares ((gGT->timer & 1) != 0).
+// La bandera nace apagada: mientras no se encienda, todos estos macros
+// devuelven exactamente el valor de antes.
+#if defined(CTR_NATIVE)
+#define CTR_NATIVE_60FPS 1
+extern int gNative60FpsEnabled;
+extern int gNativeForce30Fps;
+extern int gNativeGhostReplayFpsOverride;
