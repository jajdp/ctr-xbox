diff --git a/CMakeLists.txt b/CMakeLists.txt
index 5ac71f0..4701200 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -28,6 +28,15 @@ option(CTR_NATIVE_RENDERER_GLES
     ${CTR_NATIVE_RENDERER_GLES_DEFAULT}
 )
 
+# Port a Xbox Series (UWP). Trae el SDL3 de UWP ya compilado y fuerza el renderer de GLES,
+# que es el único camino gráfico que existe en la consola (EGL de Mesa o de ANGLE).
+option(CTR_NATIVE_UWP "Compilar para UWP (Xbox Series)" OFF)
+option(CTR_WIDESCREEN "Dibujar en panoramico 16:9 en vez de 4:3" OFF)
+set(CTR_NATIVE_UWP_DEP "" CACHE PATH "Carpeta de dependencias UWP: bin\\, lib\\ e include\\")
+# El SDL3 de UWP trae su controlador WinRT con el camino de OpenGL de escritorio (WGL), que es
+# el que alimenta Mesa para UWP; su rama de GLES por ANGLE viene desactivada en
+# SDL_build_config_winrt.h. Así que en la consola se usa el renderer de GL 3.3, no el de GLES.
+
 if(CTR_NATIVE_MACOS_BUNDLE AND NOT APPLE)
     message(FATAL_ERROR "CTR_NATIVE_MACOS_BUNDLE is supported only on Apple platforms.")
 endif()
@@ -45,7 +54,13 @@ endif()
 set(CTR_NATIVE_MSVC_FRONTEND OFF)
 if(CMAKE_C_COMPILER_ID STREQUAL "MSVC" OR CMAKE_C_SIMULATE_ID STREQUAL "MSVC")
     set(CTR_NATIVE_MSVC_FRONTEND ON)
-    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
+    if(CTR_NATIVE_UWP)
+        # UWP no admite el CRT estático (MSB8024): va el dinámico, que además llega
+        # a la consola dentro del paquete de VCLibs.
+        set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
+    else()
+        set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
+    endif()
 endif()
 
 string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" CTR_NATIVE_SYSTEM_PROCESSOR_LOWER)
@@ -201,7 +216,22 @@ set(SDL_SNDIO OFF CACHE BOOL "" FORCE)
 set(SDL_SNDIO_SHARED OFF CACHE BOOL "" FORCE)
 set(SDL_X11_XSCRNSAVER OFF CACHE BOOL "" FORCE)
 set(SDL_X11_XTEST OFF CACHE BOOL "" FORCE)
-add_subdirectory(externals/SDL)
+if(CTR_NATIVE_UWP)
+    # Port a Xbox Series (UWP): no se compila el SDL3 vendido, se enlaza el SDL3 de UWP
+    # (XboxEmulationHub/SDL3-uwp), que trae el controlador de vídeo WinRT y el puente EGL.
+    if(NOT CTR_NATIVE_UWP_DEP)
+        message(FATAL_ERROR "CTR_NATIVE_UWP necesita -DCTR_NATIVE_UWP_DEP=<carpeta con bin\\, lib\\ e include\\>")
+    endif()
+    add_library(SDL3::SDL3 SHARED IMPORTED GLOBAL)
+    set_target_properties(SDL3::SDL3 PROPERTIES
+        IMPORTED_IMPLIB "${CTR_NATIVE_UWP_DEP}/lib/SDL3.lib"
+        IMPORTED_LOCATION "${CTR_NATIVE_UWP_DEP}/bin/SDL3.dll"
+        INTERFACE_INCLUDE_DIRECTORIES "${CTR_NATIVE_UWP_DEP}/include"
+    )
+    message(STATUS "CTR Native: UWP con SDL3 de ${CTR_NATIVE_UWP_DEP}")
+else()
+    add_subdirectory(externals/SDL)
+endif()
 
 # CTR Native
 set(CTR_NATIVE_EXECUTABLE_OPTIONS)
@@ -335,6 +365,38 @@ target_compile_definitions(ctr_native PRIVATE
 if(CTR_NATIVE_RENDERER_GLES)
     target_compile_definitions(ctr_native PRIVATE CTR_NATIVE_RENDERER_GLES=1)
 endif()
+
+if(CTR_WIDESCREEN)
+    target_compile_definitions(ctr_native PRIVATE CTR_NATIVE_WIDESCREEN=1)
+endif()
+if(CTR_NATIVE_UWP)
+    target_compile_definitions(ctr_native PRIVATE
+        CTR_NATIVE_UWP=1
+        _CRT_NONSTDC_NO_DEPRECATE
+        _CRT_NONSTDC_NO_WARNINGS
+        _CRT_SECURE_NO_WARNINGS
+    )
+    # Los proyectos de Windows Store llevan /sdl, que asciende a error avisos que el resto
+    # de plataformas solo imprime (nombres POSIX, menos unario sobre sin signo).
+    target_compile_options(ctr_native PRIVATE /sdl- /wd4996 /wd4146 /wd4308)
+    # El arranque de WinRT que trae SDL es C++ (usa WRL), así que va en su propio archivo,
+    # y ese sí se compila con /ZW (C++/CX): es lo que exige SDL_main_impl.h para WinRT.
+    enable_language(CXX)
+    # Aplicación de ventana, no de consola: el CRT debe entrar por el WinMain que pone SDL.
+    set_target_properties(ctr_native PROPERTIES WIN32_EXECUTABLE TRUE)
+    target_sources(ctr_native PRIVATE platform/uwp/ctr_uwp_main.cpp)
+    # Sin /ZW: con C++/CX, vccorlib exige un main de Platform::Array y choca con el CRT.
+    # SDL contempla justo este caso con SDL_WINRT_METADATA_FILE_AVAILABLE, que desactiva su
+    # exigencia de /ZW y deja un WinMain normal.
+    set_source_files_properties(platform/uwp/ctr_uwp_main.cpp PROPERTIES
+        COMPILE_DEFINITIONS "SDL_WINRT_METADATA_FILE_AVAILABLE"
+    )
+    target_link_libraries(ctr_native WindowsApp.lib)
+    # El hilo principal de una aplicación WinRT nace con 1 MB de pila, frente a los 8 MB que
+    # da el CRT en un programa de escritorio. El juego viene de la PS1 y gasta pila a manos
+    # llenas (estructuras enteras como locales), así que se le reserva sitio de verdad.
+    target_link_options(ctr_native PRIVATE /STACK:33554432)
+endif()
 if(CTR_NATIVE_MSVC_FRONTEND)
     target_compile_options(ctr_native PRIVATE
         /W4 #TODO(aalhendi): fix warnings
