+// CTR_FPS_READOUT: cadencia para la pantalla.
+//
+// Platform_CalcFPS() ya cuenta cuadros presentados, pero solo informa cada
+// NATIVE_FPS_REPORT_FRAME_WINDOW (2000) y por el registro. Para mirarlo en la
+// tele hace falta un valor fresco, así que se mide aparte cada medio segundo.
+// Se cuenta en el mismo sitio (Platform_EndFrame), es decir una vez por imagen
+// PRESENTADA, no por tick de lógica.
+#define NATIVE_FPS_READOUT_REFRESH_SECONDS 0.5
+
+// Encendido de fábrica: en la consola no hay teclado ni variables que tocar.
+global_variable int s_fpsReadoutVisible = 1;
+global_variable int s_fpsReadoutFrames = 0;
+global_variable u64 s_fpsReadoutCounter = 0;
+global_variable char s_fpsReadoutText[32] = "-- FPS";
+
+internal void NativeFps_Update(void)
+{
+	const u64 freq = SDL_GetPerformanceFrequency();
+	const u64 now = SDL_GetPerformanceCounter();
+	f64 elapsedSeconds;
+
+	if (freq == 0)
+	{
+		return;
+	}
+
+	if ((s_fpsReadoutCounter == 0) || (now <= s_fpsReadoutCounter))
+	{
+		s_fpsReadoutCounter = now;
+		s_fpsReadoutFrames = 0;
+		return;
+	}
+
+	s_fpsReadoutFrames++;
+	elapsedSeconds = (f64)(now - s_fpsReadoutCounter) / (f64)freq;
+	if (elapsedSeconds < NATIVE_FPS_READOUT_REFRESH_SECONDS)
+	{
+		return;
+	}
+
+	{
+		// CTR es un juego de 30 Hz: la velocidad es lo que delata el juego lento
+		// aunque la imagen parezca estable.
+		const f64 fps = (f64)s_fpsReadoutFrames / elapsedSeconds;
+		snprintf(s_fpsReadoutText, sizeof(s_fpsReadoutText), "%.1f FPS %.2fX", fps, fps / (f64)CTR_FRAMES_PER_SECOND);
+	}
+
+	s_fpsReadoutCounter = now;
+	s_fpsReadoutFrames = 0;
+}
+
+int NativeFps_IsVisible(void)
+{
+	return s_fpsReadoutVisible;
+}
+
+void NativeFps_Toggle(void)
+{
+	s_fpsReadoutVisible = !s_fpsReadoutVisible;
+	// Sin rastro en el registro no hay manera de saber, desde el PC, si una
+	// pulsación llegó o si lo que falla es el dibujo.
+	Platform_Log("[CTR Native] FPS readout %s\n", s_fpsReadoutVisible ? "on" : "off");
+}
+
+const char *NativeFps_Text(void)
+{
+	return s_fpsReadoutText;
+}
