diff --git a/src/audio/wasapi/SDL_wasapi_winrt.cpp b/src/audio/wasapi/SDL_wasapi_winrt.cpp
index 3ef3cb2..5049814 100644
--- a/src/audio/wasapi/SDL_wasapi_winrt.cpp
+++ b/src/audio/wasapi/SDL_wasapi_winrt.cpp
@@ -30,6 +30,14 @@
 #include <windows.media.devices.h>
 #include <wrl/implements.h>
 #include <collection.h>
+#include <stdio.h>
+
+// how long to wait for a DeviceWatcher to finish its first pass before giving
+// up on it; see SDL_WasapiDeviceEventHandler::WaitForCompletion
+#define SDL_WASAPI_ENUM_TIMEOUT_MS 3000
+
+// same idea for ActivateAudioInterfaceAsync; see WASAPI_ActivateDevice
+#define SDL_WASAPI_ACTIVATE_TIMEOUT_MS 4000
 
 extern "C" {
 #include "../../core/windows/SDL_windows.h"
@@ -202,7 +210,16 @@ void SDL_WasapiDeviceEventHandler::OnDefaultCaptureDeviceChanged(Platform::Objec
 void SDL_WasapiDeviceEventHandler::WaitForCompletion()
 {
     if (this->completed_semaphore) {
-        SDL_WaitSemaphore(this->completed_semaphore);
+        // A DeviceWatcher delivers its events through the dispatcher of the
+        // thread that created it. An app whose main loop runs on the view
+        // thread (which is what SDL_WinRTApp::Run does) blocks here forever:
+        // the EnumerationCompleted event cannot be delivered while we wait for
+        // it. Cap the wait and carry on with whatever devices did arrive.
+        if (!SDL_WaitSemaphoreTimeout(this->completed_semaphore, SDL_WASAPI_ENUM_TIMEOUT_MS)) {
+            fprintf(stderr, "[SDL WASAPI] la enumeracion de %s no termino en %d ms; seguimos\n",
+                    this->recording ? "captura" : "reproduccion", SDL_WASAPI_ENUM_TIMEOUT_MS);
+            fflush(stderr);
+        }
         SDL_DestroySemaphore(this->completed_semaphore);
         this->completed_semaphore = nullptr;
     }
@@ -270,7 +287,12 @@ private:
 void SDL_WasapiActivationHandler::WaitForCompletion()
 {
     if (completion_semaphore) {
-        SDL_WaitSemaphore(completion_semaphore);
+        // the FIXME below is real: this used to block for good on Xbox UWP.
+        // Cap it so a device that never answers cannot hang the whole app.
+        if (!SDL_WaitSemaphoreTimeout(completion_semaphore, SDL_WASAPI_ACTIVATE_TIMEOUT_MS)) {
+            fprintf(stderr, "[SDL WASAPI] la activacion del dispositivo no respondio en %d ms\n", SDL_WASAPI_ACTIVATE_TIMEOUT_MS);
+            fflush(stderr);
+        }
         SDL_DestroySemaphore(completion_semaphore);
         completion_semaphore = NULL;
     }
